// PS Tracker data model. Domain rules live in docs/system-context.md.
// Strength figures, cycle position and base duties are derived in /lib, never stored.
// Dates are stored as "YYYY-MM-DD" strings: rosters are whole days, so there is no timezone to get wrong.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Shift {
  id          String           @id // "A" | "B" | "C"
  name        String
  // Day index (days since 1970-01-01) on which this shift starts PM Day 1. See lib/cycle.ts.
  cycleAnchor Int
  staff       Staff[]
  lockedDates LockedDate[]
  events      SpecialEvent[]
  opsDuties   OpsDuty[]
  extraHosted ExtraShiftDuty[]
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  // "STAFF" | "SUPERVISOR" | "MANAGEMENT". Management has no shift and never takes leave.
  role      String
  shiftId   String?
  shift     Shift?   @relation(fields: [shiftId], references: [id])
  // "YYYY-MM-DD". Drives BD / BD-IL.
  birthday  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  dutyOverrides    DutyOverride[]
  extraDuties      ExtraDuty[]
  extraShiftDuties ExtraShiftDuty[]
  leaves           Leave[]          @relation("LeaveStaff")
  leavesGiven      Leave[]          @relation("LeaveGivenBy")
  leavesDecided    Leave[]          @relation("LeaveDecidedBy")
  taskAssignments  TaskAssignment[]
  sessions         Session[]
  swapsRequested   DutySwap[]       @relation("SwapRequester")
  swapsPartnered   DutySwap[]       @relation("SwapPartner")
}

model Session {
  token     String   @id
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// A duty set by a supervisor that replaces the person's cycle duty for one day.
// V, V(SB) and Off(V) are stored the same way (one duty picker). AM and PM come from the cycle
// only: supervisors do not set them (spec 5.1).
model DutyOverride {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date    String
  duty    String // "V" | "VSB" | "OFF"

  @@unique([staffId, date])
}

// DOS / DOS2IC / FDO: a 24-hour duty on top of the person's AM duty for one day (spec 5.2).
model ExtraDuty {
  id      String @id @default(cuid())
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date    String
  kind    String // "DOS" | "DOS2IC" | "FDO"

  @@unique([staffId, date])
}

model LeaveType {
  code      String  @id // short code shown on the chip, max 6 characters
  name      String
  halfDay   Boolean @default(false)
  custom    Boolean @default(false)
  sortOrder Int     @default(0)
  leaves    Leave[]
}

model Leave {
  id           String     @id @default(cuid())
  staffId      String
  staff        Staff      @relation("LeaveStaff", fields: [staffId], references: [id], onDelete: Cascade)
  typeCode     String
  type         LeaveType  @relation(fields: [typeCode], references: [code])
  half         String? // "FIRST" | "SECOND" for half-day types
  // "PENDING" | "APPROVED" | "REJECTED" | "WITHDRAWN" | "CANCELLED"
  status       String
  notes        String? // staff notes on a request
  remarks      String? // supervisor remarks
  rejectReason String?
  givenById    String? // set when a supervisor/management gave the leave directly
  givenBy      Staff?     @relation("LeaveGivenBy", fields: [givenById], references: [id])
  decidedById  String?
  decidedBy    Staff?     @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  submittedAt  DateTime   @default(now())
  decidedAt    DateTime?
  // Created by the system and not negotiable: the 0.5 OIL after a DOS/FDO duty.
  autoFor      String? // ExtraDuty id
  days         LeaveDay[]
}

model LeaveDay {
  id      String @id @default(cuid())
  leaveId String
  leave   Leave  @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  date    String

  @@unique([leaveId, date])
  @@index([date])
}

model Task {
  id          String           @id @default(cuid())
  name        String // max 6 characters
  createdAt   DateTime         @default(now())
  assignments TaskAssignment[]
}

model TaskAssignment {
  id      String @id @default(cuid())
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date    String

  // One Task per person per day.
  @@unique([staffId, date])
}

model LockedDate {
  id      String @id @default(cuid())
  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])
  date    String
  remarks String

  @@unique([shiftId, date])
}

model SpecialEvent {
  id      String  @id @default(cuid())
  shiftId String
  shift   Shift   @relation(fields: [shiftId], references: [id])
  date    String
  note    String?

  @@unique([shiftId, date])
}

// A dayworker: office staff (8-5) who are not part of any shift crew but clock shift duty as Ops duty
// (spec 5.3). Never deleted, only deactivated, so the duty history behind the report is kept.
model Dayworker {
  id        String    @id @default(cuid())
  name      String
  username  String    @unique // upper case, max 7 characters, shown on the roster
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  opsDuties OpsDuty[]
}

// One dayworker clocking shift duty for one shift on one day. Several dayworkers can share a day.
model OpsDuty {
  id          String    @id @default(cuid())
  dayworkerId String
  dayworker   Dayworker @relation(fields: [dayworkerId], references: [id], onDelete: Cascade)
  shiftId     String
  shift       Shift     @relation(fields: [shiftId], references: [id])
  date        String

  // A dayworker clocks at most one shift per day.
  @@unique([dayworkerId, date])
  @@index([shiftId, date])
}

// Extra shift duty (spec 5.4): a person from another shift serving extra duty on a host shift day.
model ExtraShiftDuty {
  id          String @id @default(cuid())
  staffId     String
  staff       Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  hostShiftId String
  hostShift   Shift  @relation(fields: [hostShiftId], references: [id])
  date        String

  @@unique([staffId, date])
  @@index([hostShiftId, date])
}

// A duty swap between two people (spec 11.4), usually across shifts. On each of its dates (one, or two
// for a give-and-take) the two exchange their duties for that day. Nothing else is stored: the roster
// derives the exchanged duties, so cancelling a swap restores both people's normal days.
// Flow: requested -> partner accepts -> each side's shift supervisor approves (Management can approve
// both). A supervisor or Management can also record one directly with their side pre-approved.
model DutySwap {
  id                 String        @id @default(cuid())
  requesterId        String
  requester          Staff         @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  partnerId          String
  partner            Staff         @relation("SwapPartner", fields: [partnerId], references: [id], onDelete: Cascade)
  // Each person's shift when the swap was made: that shift's supervisor approves their side.
  requesterShiftId   String
  partnerShiftId     String
  // "PENDING_PARTNER" | "PENDING_APPROVAL" | "APPROVED" | "DECLINED" | "REJECTED" | "WITHDRAWN" | "CANCELLED"
  status             String
  notes              String?
  rejectReason       String?
  createdById        String // the requester, or the supervisor / Management who recorded it
  partnerRespondedAt DateTime?
  // Who approved each side. A same-shift swap needs one approval for both.
  requesterSideById  String?
  partnerSideById    String?
  submittedAt        DateTime      @default(now())
  decidedById        String? // who approved the last side, rejected or cancelled
  decidedAt          DateTime?
  days               DutySwapDay[]

  @@index([status])
}

model DutySwapDay {
  id     String   @id @default(cuid())
  swapId String
  swap   DutySwap @relation(fields: [swapId], references: [id], onDelete: Cascade)
  date   String

  @@unique([swapId, date])
  @@index([date])
}
